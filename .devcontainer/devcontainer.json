{
  "name": "OmniBot Sim Demo (ROS 2 Jazzy)",
  "build": {
    "dockerfile": "../Dockerfile.sim",
    "context": ".."
  },
  "runArgs": [
    "--network=host",
    "--ipc=host"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "30",
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
    "CYCLONEDDS_URI": "file:///workspaces/OmniBot/omnibot-ros2/omnibot_bringup/config/dds/cyclonedds.xml",
    "OMNIBOT_PI_IP": "192.0.2.10",
    "OMNIBOT_WS_IP": "192.0.2.20",
    "OMNIBOT_WORKSTATION_IP": "192.0.2.20",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GALLIUM_DRIVER": "llvmpipe",
    "MESA_GL_VERSION_OVERRIDE": "3.3",
    "QT_QPA_PLATFORM": "offscreen"
  },
  "workspaceFolder": "/workspaces/OmniBot",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/OmniBot,type=bind,consistency=cached",
  "postCreateCommand": "bash /workspaces/OmniBot/omnibot-digital-twin/docker/post_create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  "forwardPorts": [8765, 9090, 8080],
  "remoteUser": "user"
}
