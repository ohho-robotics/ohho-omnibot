# OmniBot simulation image (headless Gazebo Harmonic + Nav2 + workspace)
# Base: ROS 2 Jazzy on Ubuntu 24.04 (Noble)
# Published to GHCR: ghcr.io/ohho-robotics/omnibot-sim
#
# The image default is CPU software rendering (llvmpipe). CI and
# docker-compose.yml rely on that. docker-compose.gpu.yml overrides it at
# runtime for Ogre2 EGL on an NVIDIA GPU. Do not flip LIBGL_ALWAYS_SOFTWARE
# here.

FROM ros:jazzy-ros-base-noble

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy \
    ROS_DOMAIN_ID=30 \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe \
    MESA_GL_VERSION_OVERRIDE=3.3 \
    QT_QPA_PLATFORM=offscreen

# ── 1. System packages & dependencies ──────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales \
    # Headless software rendering (Mesa + llvmpipe + xvfb).
    # libglvnd0 is the dispatcher the NVIDIA Container Toolkit uses to
    # hand EGL to the host driver when the GPU compose file selects it.
    libgl1-mesa-dri \
    libegl1 \
    libegl-mesa0 \
    libglx-mesa0 \
    libglu1-mesa \
    libglvnd0 \
    libgl1 \
    libgles2 \
    xvfb \
    # ROS 2 desktop (includes RViz2, rqt)
    ros-jazzy-desktop \
    # Gazebo Harmonic + ROS bridge
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    # Navigation stack & localization
    ros-jazzy-nav2-bringup \
    ros-jazzy-nav2-costmap-2d \
    ros-jazzy-slam-toolbox \
    ros-jazzy-robot-localization \
    # Visualization & telemetry bridges
    ros-jazzy-foxglove-bridge \
    ros-jazzy-rosbridge-suite \
    ros-jazzy-web-video-server \
    ros-jazzy-depthimage-to-laserscan \
    ros-jazzy-teleop-twist-keyboard \
    ros-jazzy-topic-tools \
    # Build tools & utilities
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    python3-pytest \
    python3-vcstool \
    git \
    wget \
    curl \
    sudo \
    # OpenCV (for BEV stitcher) & serial driver
    python3-opencv \
    libopencv-dev \
    python3-serial \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ── 2. Python core dependencies ───────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages \
    "numpy<2.0" \
    pyyaml \
    pyserial \
    fastapi \
    uvicorn \
    httpx

# ── 3. Non-root user setup ────────────────────────────────────────────────────
ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=1000
RUN if getent group $USER_GID >/dev/null 2>&1; then \
      existing_group=$(getent group $USER_GID | cut -d: -f1); \
    else \
      existing_group=$USERNAME; \
      groupadd --gid $USER_GID $USERNAME; \
    fi && \
    if id -u $USER_UID >/dev/null 2>&1; then \
      existing_user=$(id -nu $USER_UID); \
      if [ "$existing_user" != "$USERNAME" ]; then \
        usermod -l $USERNAME -d /home/$USERNAME -m $existing_user 2>/dev/null || true; \
      fi; \
    else \
      useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
    fi && \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ── 4. Rosdep initialization ──────────────────────────────────────────────────
RUN rosdep init 2>/dev/null || true && rosdep update

# ── 5. Copy workspace sources and build ────────────────────────────────────────
WORKDIR /workspaces/OmniBot
COPY . /workspaces/OmniBot

# Fix symlinks if checked out on a filesystem without symlink support
RUN for link in src/*; do \
      if [ -f "$link" ] && [ ! -L "$link" ]; then \
        target=$(cat "$link"); \
        rm "$link"; \
        ln -s "$target" "$link"; \
      fi; \
    done

# Install editable packages
RUN pip3 install --no-cache-dir --break-system-packages \
    -e mecanum-kinematics \
    -e yahboom-python-driver \
    -e omnibot-ai-engines/learning_engine \
    -e omnibot-ai-engines/agent_engine

# Install rosdep dependencies (skip unneeded 3D mapping and GUI stacks)
RUN apt-get update && \
    rosdep install --from-paths src --ignore-src -y --rosdistro jazzy \
      --dependency-types=build \
      --dependency-types=buildtool \
      --dependency-types=build_export \
      --dependency-types=buildtool_export \
      --dependency-types=exec \
      --skip-keys "rtabmap_ros octomap_server pcl_ros octomap_msgs joint_state_publisher_gui" && \
    rm -rf /var/lib/apt/lists/*

# Build colcon workspace into /opt/omnibot/install
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --symlink-install --install-base /opt/omnibot/install --base-paths src && \
    rm -rf /workspaces/OmniBot/install && \
    ln -s /opt/omnibot/install /workspaces/OmniBot/install

# Fix permissions for the non-root user
RUN chown -R $USER_UID:$USER_GID /workspaces/OmniBot /opt/omnibot

# ── 6. Environment & entrypoint setup ─────────────────────────────────────────
RUN echo "source /opt/ros/jazzy/setup.bash" >> /etc/bash.bashrc \
    && echo "if [ -f /opt/omnibot/install/setup.bash ]; then source /opt/omnibot/install/setup.bash; fi" >> /etc/bash.bashrc \
    && echo "export ROS_DOMAIN_ID=30" >> /etc/bash.bashrc

# Entrypoint script that ensures environment is sourced for any command
RUN printf '#!/bin/bash\nset -e\nsource /opt/ros/jazzy/setup.bash\nif [ -f /opt/omnibot/install/setup.bash ]; then source /opt/omnibot/install/setup.bash; fi\nif [ -f /workspaces/OmniBot/install/setup.bash ] && [ ! /workspaces/OmniBot/install/setup.bash -ef /opt/omnibot/install/setup.bash ]; then source /workspaces/OmniBot/install/setup.bash; fi\nexec "$@"\n' > /omnibot_entrypoint.sh \
    && chmod +x /omnibot_entrypoint.sh

USER $USERNAME
WORKDIR /workspaces/OmniBot

ENTRYPOINT ["/omnibot_entrypoint.sh"]
CMD ["/bin/bash"]
