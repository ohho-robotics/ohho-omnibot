  <disable_collisions link1="apriltag_front_link" link2="right_camera_link" reason="Never"/>
  <disable_collisions link1="apriltag_front_link" link2="so_fl_a_standoff_link" reason="Never"/>
  <disable_collisions link1="apriltag_front_link" link2="so_fl_b_standoff_link" reason="Never"/>
  <disable_collisions link1="apriltag_front_link" link2="so_fr_a_standoff_link" reason="Never"/>
  <disable_collisions link1="apriltag_front_link" link2="so_fr_b_standoff_link" reason="Never"/>
  <disable_collisions link1="apriltag_front_link" link2="so_rl_a_standoff_link" reason="Never"/>
  <disable_collisions link1="apriltag_front_link" link2="so_rl_b_standoff_link" reason="Never"/>
