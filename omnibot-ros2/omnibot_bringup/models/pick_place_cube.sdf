<?xml version="1.0" ?>
<!--
  Copyright 2026 OhhO Robotics
  SPDX-License-Identifier: Apache-2.0

  Rigid 4 cm cube spawned only by sim.launch.py pick_place:=true.
  Dynamic, light enough for the SO-101 gripper. Origin is the cube centre.
-->
<sdf version="1.8">
  <model name="pick_place_cube">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.04</mass>
        <inertia>
          <ixx>1.067e-5</ixx>
          <iyy>1.067e-5</iyy>
          <izz>1.067e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material>
          <ambient>0.95 0.45 0.08 1</ambient>
          <diffuse>0.95 0.45 0.08 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
