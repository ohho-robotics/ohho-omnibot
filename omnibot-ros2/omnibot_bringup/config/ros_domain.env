# OmniBot Pi + GPU workstation ROS 2 DDS settings (OHH-97).
# No secrets — copy to your shell or source before launch on both machines.
#
#   set -a && source omnibot-ros2/omnibot_bringup/config/ros_domain.env && set +a
#
# Replace placeholder IPs with the addresses Varun confirms on the LAN.

# Shared DDS domain (must match on Pi and workstation).
ROS_DOMAIN_ID=30

# Raspberry Pi 5 (base, arm, sensors).
OMNIBOT_PI_IP=192.0.2.10

# GPU workstation (policy / VLA inference).
OMNIBOT_WORKSTATION_IP=192.0.2.20

# Cyclone DDS peer list for two-machine discovery (export on each host).
# On the Pi:     export ROS_STATIC_PEERS=<workstation-ip>
# On the GPU PC: export ROS_STATIC_PEERS=<pi-ip>
# Example after filling IPs above:
#   export ROS_STATIC_PEERS=${OMNIBOT_WORKSTATION_IP}
#   export ROS_STATIC_PEERS=${OMNIBOT_PI_IP}
