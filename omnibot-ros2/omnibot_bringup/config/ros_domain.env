# OmniBot Pi + GPU workstation ROS 2 DDS settings (OHH-97, OHH-397).
# No secrets. Source with bash before launch on both machines:
#
#   source omnibot-ros2/omnibot_bringup/config/ros_domain.env
#
# or, from the repo root (also prints the peer list):
#
#   source scripts/net_env.sh
#
# OMNIBOT_PI_IP and OMNIBOT_WORKSTATION_IP are RFC 5737 TEST-NET-1
# documentation addresses. They are not routable. Replace them with the
# LAN addresses of the Raspberry Pi and the GPU workstation. Do not commit
# those LAN addresses. OMNIBOT_WS_IP is the name cyclonedds.xml reads.

# Shared DDS domain (must match on the Pi, the workstation, and sim).
export ROS_DOMAIN_ID=30

# One RMW for the cell. Do not mix this with rmw_fastrtps_cpp.
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Raspberry Pi (base, arm, sensors).
export OMNIBOT_PI_IP=192.0.2.10

# GPU workstation (policy / perception). OHH-97 name, kept.
export OMNIBOT_WORKSTATION_IP=192.0.2.20

# Alias read by config/dds/cyclonedds.xml.
export OMNIBOT_WS_IP="${OMNIBOT_WORKSTATION_IP}"

# Used only when CYCLONEDDS_URI is unset (generated Cyclone config).
# The checked-in profile is the cell default and lists the same peers.
export ROS_STATIC_PEERS="${OMNIBOT_PI_IP};${OMNIBOT_WS_IP}"

# Profile path next to this file. Cyclone expands ${OMNIBOT_PI_IP} and
# ${OMNIBOT_WS_IP} at process start. Pre-set CYCLONEDDS_URI to keep another
# file (for example the interface overlay from scripts/net_env.sh).
if [ -n "${BASH_SOURCE:-}" ]; then
  _omnibot_dds_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dds"
  export CYCLONEDDS_URI="${CYCLONEDDS_URI:-file://${_omnibot_dds_dir}/cyclonedds.xml}"
  unset _omnibot_dds_dir
fi
