<?xml version="1.0" ?>
<!--
  Copyright 2026 OhhO Robotics
  SPDX-License-Identifier: Apache-2.0

  Small apartment for `ros2 launch omnibot_bringup sim.launch.py world:=apartment`.
  One room with a kitchen (counter, stove, fridge), a desk, and a door in the
  south wall. Primitive boxes only — no Fuel downloads.
-->
<sdf version="1.8">
  <world name="apartment">

    <physics name="phys" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.88 0.8 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.48 0.38 1</ambient>
            <diffuse>0.55 0.48 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room is 7 m (X) by 5 m (Y), walls 2.4 m tall. Door gap on the south wall. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.5 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.3 0.15 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.3 0.15 2.4</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south_west">
      <static>true</static>
      <pose>-2.05 -2.5 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.05 0.15 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.05 0.15 2.4</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south_east">
      <static>true</static>
      <pose>2.05 -2.5 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.05 0.15 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.05 0.15 2.4</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.5 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 5.15 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 5.15 2.4</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.5 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 5.15 2.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 5.15 2.4</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Door leaf, ajar in the south-wall opening. -->
    <model name="door">
      <static>true</static>
      <pose>0.15 -2.35 1.02 0 0 0.5</pose>
      <link name="leaf">
        <collision name="collision">
          <geometry><box><size>0.04 0.9 2.04</size></box></geometry>
        </collision>
        <visual name="leaf">
          <geometry><box><size>0.04 0.9 2.04</size></box></geometry>
          <material>
            <ambient>0.45 0.28 0.14 1</ambient>
            <diffuse>0.45 0.28 0.14 1</diffuse>
          </material>
        </visual>
        <visual name="handle">
          <pose>0.03 0.25 0.05 0 0 0</pose>
          <geometry><box><size>0.03 0.12 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.7 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Kitchen along the west wall: counter, stove, fridge. -->
    <model name="kitchen_counter">
      <static>true</static>
      <pose>-2.95 0.7 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 2.0 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 2.0 0.9</size></box></geometry>
          <material>
            <ambient>0.75 0.72 0.66 1</ambient>
            <diffuse>0.75 0.72 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="stove">
      <static>true</static>
      <pose>-2.95 1.45 0.98 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.55 0.55 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.55 0.55 0.12</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fridge">
      <static>true</static>
      <pose>-2.9 -1.15 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 1.8</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.92 1</ambient>
            <diffuse>0.9 0.9 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Graspable dataset object on the desk. Dynamic (not static), light
         enough for the SO-101 gripper, sitting on the desktop at z=0.76. -->
    <model name="grasp_cube">
      <static>false</static>
      <pose>2.20 0.40 0.785 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia>
            <ixx>1.067e-5</ixx>
            <iyy>1.067e-5</iyy>
            <izz>1.067e-5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.08 1</ambient>
            <diffuse>0.95 0.45 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Desk on the east side of the room. -->
    <model name="desk">
      <static>true</static>
      <pose>2.55 0.4 0.38 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.76</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.76</size></box></geometry>
          <material>
            <ambient>0.55 0.36 0.18 1</ambient>
            <diffuse>0.55 0.36 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
