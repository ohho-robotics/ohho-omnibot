# Third-party Unity packages checked into the tree. GitHub Linguist
# otherwise counts their C# and reports this ROS 2 repo as mostly C#.
# omnibot-vr/Packages/manifest.json is this project's dependency list
# and is left unmarked.
omnibot-vr/Packages/com.coplaydev.unity-mcp/** linguist-vendored
omnibot-vr/Packages/com.meta.xr.sdk.core/** linguist-vendored
omnibot-vr/Packages/com.meta.xr.sdk.interaction/** linguist-vendored

# Shell scripts must keep LF so they run on Linux when checked out on Windows.
*.sh text eol=lf

# Saved slam_toolbox map: byte-exact, no diffs.
omnibot-ros2/omnibot_navigation/maps/*.pgm binary
omnibot-ros2/omnibot_navigation/maps/*.posegraph binary linguist-generated
omnibot-ros2/omnibot_navigation/maps/*.data binary linguist-generated

# Printable PDF and tag textures must stay byte-exact. autocrlf would break them.
omnibot-ros2/omnibot_description/apriltags/print/*.pdf binary
omnibot-ros2/omnibot_description/meshes/apriltags/*.png binary

# Files copied into the desktop image must keep LF; the Windows launcher keeps CRLF.
docker/desktop/rootfs/** text eol=lf
*.cmd text eol=crlf
