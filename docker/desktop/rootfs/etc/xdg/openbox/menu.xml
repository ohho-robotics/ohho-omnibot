<?xml version="1.0" encoding="UTF-8"?>
<!-- Right-click menu of the OmniBot browser desktop. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="OmniBot">
    <item label="Terminal">
      <action name="Execute"><command>xterm -fa Monospace -fs 10</command></action>
    </item>
    <separator />
    <item label="Restart sim (flat)">
      <action name="Execute"><command>env OMNIBOT_WORLD=flat omnibot-desktop-sim restart</command></action>
    </item>
    <item label="Restart sim (apartment)">
      <action name="Execute"><command>env OMNIBOT_WORLD=apartment omnibot-desktop-sim restart</command></action>
    </item>
    <item label="Stop sim">
      <action name="Execute"><command>omnibot-desktop-sim stop</command></action>
    </item>
    <item label="RViz">
      <action name="Execute"><command>bash -c "source /opt/ros/jazzy/setup.bash; source /opt/omnibot/install/setup.bash; rviz2 -d $(ros2 pkg prefix omnibot_bringup)/share/omnibot_bringup/config/sim_desktop.rviz --ros-args -p use_sim_time:=true"</command></action>
    </item>
    <separator />
    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>
  </menu>
</openbox_menu>
